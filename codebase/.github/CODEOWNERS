# CODEOWNERS — required reviewers for sensitive, high-blast-radius paths.
#
# GitHub enforces these rules when branch protection has "Require review from
# Code Owners" enabled on the default branch. A matching change cannot merge
# until at least one listed owner approves. Later matches take precedence.
#
# Replace the placeholder teams/handles below with your real GitHub org teams.
# Prefer @org/team handles over individuals so ownership survives staff changes.

# ---------------------------------------------------------------------------
# Default owners — everything, unless a more specific rule overrides below.
# ---------------------------------------------------------------------------
*                                   # TODO(owners): @your-org/llmops-maintainers

# ---------------------------------------------------------------------------
# Prompts — any prompt in any use case. Prompts are product behaviour; a change
# here can silently alter model output, so it must be reviewed by prompt owners.
# ---------------------------------------------------------------------------
/usecases/*/prompts/                # TODO(owners): @your-org/prompt-owners @your-org/ai-quality
**/*.prompt.yaml                    # TODO(owners): @your-org/prompt-owners @your-org/ai-quality

# ---------------------------------------------------------------------------
# Agents / pipelines — orchestration definitions per use case.
# ---------------------------------------------------------------------------
/usecases/*/agents/                 # TODO(owners): @your-org/agent-owners @your-org/ai-quality
**/*.agent.yaml                     # TODO(owners): @your-org/agent-owners @your-org/ai-quality

# ---------------------------------------------------------------------------
# Platform config-as-code — model catalog, tool registry, evaluators, gateway
# policies. These govern every use case; changes require platform review.
# ---------------------------------------------------------------------------
/platform/                          # TODO(owners): @your-org/platform-team
/platform/models.yaml               # TODO(owners): @your-org/platform-team @your-org/ai-quality
/platform/evaluators/               # TODO(owners): @your-org/platform-team @your-org/ai-quality
/platform/gateway/                  # TODO(owners): @your-org/platform-team @your-org/security

# ---------------------------------------------------------------------------
# Infrastructure & CI/CD — Bicep, workflows, container build. Security-adjacent.
# ---------------------------------------------------------------------------
/infra/                             # TODO(owners): @your-org/platform-team @your-org/security
/.github/                           # TODO(owners): @your-org/platform-team @your-org/security
