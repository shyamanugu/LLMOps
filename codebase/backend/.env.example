# Copy to `.env` for local development. Do NOT commit real secrets.
# In Azure, these are set as Container App env vars / Key Vault references (Managed Identity),
# not from a file. See checklist.html for how to obtain each value.

LLMOPS_ENVIRONMENT=dev
LLMOPS_LOG_LEVEL=INFO

# Azure OpenAI
LLMOPS_AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
LLMOPS_AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Dev only — in Azure use Managed Identity and leave this blank:
LLMOPS_AZURE_OPENAI_API_KEY=

# Azure AI Search (RAG)
LLMOPS_AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
LLMOPS_AZURE_SEARCH_API_KEY=

# Document Intelligence
LLMOPS_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/

# Content Safety (guardrails)
LLMOPS_CONTENT_SAFETY_ENDPOINT=https://<your-contentsafety>.cognitiveservices.azure.com/

# Cosmos DB (state / feedback)
LLMOPS_COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
LLMOPS_COSMOS_DATABASE=llmops

# Observability
LLMOPS_APPLICATIONINSIGHTS_CONNECTION_STRING=
LLMOPS_LANGFUSE_HOST=http://localhost:3000
LLMOPS_LANGFUSE_PUBLIC_KEY=
LLMOPS_LANGFUSE_SECRET_KEY=
LLMOPS_OTEL_ENABLED=true

# Prompt registry: git | langfuse | foundry
LLMOPS_PROMPT_REGISTRY=git
LLMOPS_MODELS_CONFIG_PATH=../platform/models.yaml
LLMOPS_USECASES_DIR=../usecases
