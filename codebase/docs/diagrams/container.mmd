%% C4-style Container diagram — the runnable/deployable units of the platform.
%% Render with mermaid.live or: mmdc -i container.mmd -o container.svg
graph TB
    user["End user / caller"]
    eng["Engineer"]

    subgraph edge[Edge]
        apim["API Management gateway<br/>quotas, throttling, routing"]
    end

    subgraph aca[Azure Container Apps]
        frontend["LLMOps Console<br/>React 18 + TypeScript (Vite)<br/>served by nginx"]
        api["Control-plane API<br/>FastAPI (Python 3.11)<br/>llmops.api.main"]
        runtime["Pipeline runtime<br/>llmops.orchestration<br/>sequential agent pipelines"]
    end

    fn["Azure Functions<br/>event/schedule triggers<br/>(new transcript, nightly)"]

    subgraph backendpkgs[Backend packages inside api/runtime]
        prompts["prompts (registry + render)"]
        models["models (router + client + pricing)"]
        obs["observability (tracing + cost)"]
        guard["guardrails (engine)"]
        data["data_access (RAG/SQL/docs/records)"]
        tools["tools (MCP catalog)"]
        evalpkg["evaluation (gate + metrics)"]
        feedback["feedback (capture + analytics)"]
    end

    subgraph azuresvcs[Azure data + AI services]
        aoai["Azure OpenAI"]
        search["Azure AI Search"]
        docintel["Document Intelligence"]
        safety["Content Safety"]
        cosmos["Cosmos DB"]
        appinsights["Application Insights"]
        keyvault["Key Vault"]
    end

    github["GitHub Actions<br/>pr-checks / eval-full / deploy / index-refresh"]
    langfuse["Langfuse (self-hosted container + Postgres)"]

    user --> apim --> frontend
    user --> apim --> api
    eng --> github --> api
    fn --> runtime

    frontend -->|"REST /api/v1"| api
    api --> runtime
    api --> prompts & models & obs & guard & data & tools & evalpkg & feedback
    runtime --> prompts & models & obs & guard & data & tools

    models --> aoai
    data --> search
    data --> docintel
    data --> cosmos
    guard --> safety
    obs --> appinsights
    obs --> langfuse
    feedback --> cosmos
    feedback --> appinsights
    evalpkg --> aoai
    api -->|Managed Identity| keyvault
    github -->|eval gate| aoai
    github -->|push prompt YAML on merge| langfuse
