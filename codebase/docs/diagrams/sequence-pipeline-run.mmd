%% Sequence — one request through a sequential agent pipeline (APIX example).
%% Render with mermaid.live or: mmdc -i sequence-pipeline-run.mmd -o sequence-pipeline-run.svg
sequenceDiagram
    autonumber
    actor Caller
    participant API as FastAPI (api/agents)
    participant Pipe as Pipeline (orchestration)
    participant Guard as GuardrailEngine
    participant Agent as Agent step
    participant PR as PromptRegistry
    participant MR as ModelRouter
    participant MC as ModelClient
    participant Tool as Tool (MCP)
    participant Obs as Tracing + Cost
    participant AOAI as Azure OpenAI

    Caller->>API: POST run (input, use_case)
    API->>Pipe: run(input)
    Pipe->>Obs: start request span (new trace_id)
    Pipe->>Guard: check_input(text)
    Guard->>Guard: Content Safety + PII + injection
    Guard-->>Pipe: GuardResult(allowed=true, redacted)
    loop each step in pipeline.agent.yaml
        Pipe->>Obs: start agent span
        Pipe->>Agent: run(ctx)
        Agent->>PR: load_prompt(prompt_id, label=prod)
        PR-->>Agent: PromptSpec (template, model_alias, version)
        Agent->>Agent: spec.render(**vars)
        opt step uses a tool
            Agent->>Tool: run(args)
            Tool->>Obs: tool span (expected_tool -> was_correct_tool)
            Tool-->>Agent: ToolResult
        end
        Agent->>MC: chat(alias, messages, prompt_id)
        MC->>MR: resolve(alias) -> deployment
        MC->>Obs: model_call_span (prompt_id, version)
        MC->>AOAI: chat.completions.create(deployment)
        AOAI-->>MC: response + usage
        MC->>Obs: set input/output tokens + app.cost_usd
        MC-->>Agent: ChatResult(text, usage, cost)
        Agent-->>Pipe: AgentResult (writes to shared context)
    end
    Pipe->>Guard: check_output(final_text)
    Guard-->>Pipe: GuardResult(allowed, redacted)
    Pipe->>Obs: end request span (roll up cost/latency)
    Pipe-->>API: PipelineResult
    API-->>Caller: response (coaching report)
