<!--
  APIM inbound policy — applied to the LLMOps backend API operations.

  Responsibilities (in order):
    1. Validate the caller's JWT (Entra ID / OAuth2) — authn + authz.
    2. Enforce CORS for the LLMOps Console origin.
    3. Route to the backend (Container Apps) — no secrets in this file; the
       backend URL is a named value, and the backend trusts APIM via network
       restriction + a header, not a shared key.
    4. Add correlation + forwarded identity headers for tracing.
    5. Serve safe GET responses from cache when available.

  Rate limiting / quota live in ratelimit.xml (include or merge as needed).
  Named values referenced here (configure in APIM, ideally from Key Vault):
    {{aad-tenant-id}} {{api-audience}} {{backend-base-url}} {{allowed-origin}}
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Authn/z: validate bearer token issued by Entra ID. Reject if absent/invalid. -->
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401"
                  failed-validation-error-message="Unauthorized. A valid access token is required."
                  require-expiration-time="true" require-signed-tokens="true" clock-skew="120">
      <openid-config url="https://login.microsoftonline.com/{{aad-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>{{api-audience}}</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{aad-tenant-id}}/v2.0</issuer>
      </issuers>
      <!-- TODO(authz): restrict to an app role / scope, e.g. require "LLMOps.Invoke".
      <required-claims>
        <claim name="roles" match="any"><value>LLMOps.Invoke</value></claim>
      </required-claims>
      -->
    </validate-jwt>

    <!-- 2. CORS for the Console SPA. Tighten allowed-origins to your host. -->
    <cors allow-credentials="true">
      <allowed-origins>
        <origin>{{allowed-origin}}</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300">
        <method>GET</method><method>POST</method><method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>Authorization</header><header>Content-Type</header><header>x-correlation-id</header>
      </allowed-headers>
    </cors>

    <!-- 3. Backend routing. The backend accepts traffic only from APIM (network + header). -->
    <set-backend-service base-url="{{backend-base-url}}" />

    <!-- 4. Observability: propagate/create a correlation id and forward caller identity. -->
    <set-header name="x-correlation-id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="x-forwarded-sub" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("Authorization","").Length > 0
               ? (context.User?.Id ?? "unknown") : "anonymous")</value>
    </set-header>
    <!-- Strip the bearer token from the upstream request; identity is forwarded above. -->
    <set-header name="Authorization" exists-action="delete" />

    <!-- 5. Serve cacheable GETs from the response cache (see caching in outbound). -->
    <cache-lookup vary-by-developer="false" vary-by-developer-groups="false"
                  downstream-caching-type="none" must-revalidate="true">
      <vary-by-header>Accept</vary-by-header>
      <vary-by-query-parameter>usecase</vary-by-query-parameter>
    </cache-lookup>
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <!-- Cache only safe, idempotent read responses (e.g. /models, /prompts). Short TTL. -->
    <choose>
      <when condition="@(context.Request.Method == "GET" && context.Response.StatusCode == 200)">
        <cache-store duration="60" />
      </when>
    </choose>
    <!-- Never expose backend server internals. -->
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
  </outbound>

  <on-error>
    <base />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </on-error>
</policies>
