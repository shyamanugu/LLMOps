# ============================================================================
# AIA Pipeline — environment template.  Copy to `.env` and replace placeholders.
#     cp ".env.example" ".env"      (the real .env is gitignored — never commit it)
# Each section notes the Azure service that provides the values; full creation
# steps are in docs/CLIENT_DEMO_SETUP.md.
# ============================================================================

# ── [Azure OpenAI / AI Foundry] — the LLM the pipeline calls ────────────────
# Service: Azure OpenAI (a.k.a. Azure AI Foundry). Create a resource + a chat
# model deployment; copy its endpoint, deployment name, and a key.
REASONING_MODEL_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
REASONING_MODEL_DEPLOYMENT=gpt-5.4-nano
REASONING_MODEL_APIKEY=<azure-openai-key>
# Optional: set only if you must override the derived OpenAI-compatible base URL.
REASONING_MODEL_BASE_URL=
# Optional starting output-token cap (0 = model default).
REASONING_MODEL_MAX_TOKENS=0

# ── [Azure Storage] — pipeline input/output (parquet blobs) ─────────────────
# Service: Storage Account (Blob). Create the account + the containers below.
SALES_STORAGE_ACCOUNT_NAME=<storage-account-name>
SALES_STORAGE_ACCOUNT_KEY=<storage-account-key>
AFNI_FILESTORE_CONNSTRING=<storage-connection-string>
SALES_RAW_CONTAINER=raw
SALES_DENOISED_CONTAINER=denoised
SALES_ANALYSIS_CONTAINER=analysis
SALES_SUMMARY_CONTAINER=summary
SALES_COACH_HIERARCHY_CONTAINER=coach-employee-hierarchy

# ── [Azure SQL] — individual_metrics + coach hierarchy (optional for demo) ──
# Service: Azure SQL Database. Auth mirrors the app (AAD via DefaultAzureCredential).
# Needed only for the `individual_metrics` and `kpi` steps; denoise→analysis→
# summary run without it.
APP_AZURE_SQL_SERVER=<sql-server>.database.windows.net
APP_AZURE_SQL_DATABASE=<database-name>
APP_AZURE_SQL_PORT=1433
APP_AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}
APP_AZURE_SQL_LOGIN_TIMEOUT=90
APP_AZURE_SQL_QUERY_TIMEOUT=0

# ── [Program → ProgramName mapping] — which raw rows each mode processes ─────
# Comma-separated ProgramName values as they appear in the raw data.
TELESALES_PROGRAMS=VZW Telesales
WCC_PROGRAMS=<wcc program names>
PSO_PROGRAMS=<pso program names>

# ── [Prefect] — batch orchestration (external, not Azure) ───────────────────
PREFECT_API_URL=<prefect-api-url>
PREFECT_API_DATABASE_CONNECTION_URL=
PREFECT_LOGGING_LEVEL=INFO

# ============================================================================
# LLMOps integration settings (all optional — sensible defaults if unset)
# ============================================================================

# Runtime DATA mode:  mock | real   (default: mock)  ← flip this one line to switch
#   mock -> pipeline reads/writes parquet on the LOCAL filesystem (no Azure Storage
#           needed). Great for a laptop demo. (LLM still uses REASONING_MODEL_* — set
#           a key, or use the zero-dependency UI demo on the bundled sample data.)
#   real -> plug into actual Azure Blob (raw transcripts) + Azure SQL. Requires the
#           Storage/SQL blocks above to be filled in.
AI_PIPELINE_MODE=mock

# Local data dir used in mock mode (containers become sub-folders here).
# Seed it with: python -m ai_pipeline.tools.make_sample_raw --date 2025-08-28 --local
AI_PIPELINE_LOCAL_DATA_DIR=./data

# Environment key used to resolve model aliases / guardrail policy / eval
# thresholds from the platform config (dev | test | prod).
AI_PIPELINE_ENV=dev

# Observability tracer:  memory (default) | null | jsonl | azure
#   jsonl  -> writes StepEvents to AI_PIPELINE_TRACE_FILE (feeds the demo UI; no Azure needed)
#   azure  -> ships to Azure Monitor (needs APPLICATIONINSIGHTS_CONNECTION_STRING)
AI_PIPELINE_TRACER=jsonl
AI_PIPELINE_TRACE_FILE=traces/trace.jsonl

# ── [Application Insights] — only if AI_PIPELINE_TRACER=azure ───────────────
# Service: Application Insights (+ Log Analytics workspace).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── [Azure OpenAI for the platform] — LLM-judge evals + any platform provider
# The platform's provider reads THESE (distinct from REASONING_MODEL_* above).
# Set only if you run the eval gate's llm_judge evaluator.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ── [Azure AI Content Safety] — only if you enable it in guardrails.yaml ────
# Service: Azure AI Content Safety.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=

# ── Local paths / filters (optional) ────────────────────────────────────────
# Override where the platform services live (defaults to ../../platform/services).
LLMOPS_PLATFORM_ROOT=
# Local feedback store for the improve-loop (feedback_gate).
AI_PIPELINE_FEEDBACK_PATH=feedback/feedback.jsonl
# Optional coach/agent allow-lists (comma-separated IDs).
AI_PIPELINE_COACH_FILTER=
AI_PIPELINE_AGENT_FILTER=
