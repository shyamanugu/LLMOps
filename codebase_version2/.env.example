# Copy to `.env`. Leave blank to run in offline mock mode.
# Azure OpenAI (the models)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Dev only; in Azure use Managed Identity and leave blank:
AZURE_OPENAI_API_KEY=
APP_ENV=dev

# Azure AI Search (real RAG). Blank = use the local in-memory retriever.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# Azure AI Content Safety (real guardrails). Blank = use the simple built-in checks.
CONTENT_SAFETY_ENDPOINT=

# Langfuse (LLM observability). Blank = trace to the console only.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
