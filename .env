# Foundation configuration — placeholder values only, no live secrets.
# See docs/decisions/0001-repo-foundation-approach.md for why this file is tracked in source
# instead of ignored, and why Key Vault is not used yet.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus
ENVIRONMENT=dev
RESOURCE_GROUP_NAME=rg-llmops-dev-eastus-001
MANAGED_IDENTITY_NAME=id-llmops-dev-eastus-001

# Model Management — real values belong in .env.local (gitignored), not here.
AZURE_OPENAI_ENDPOINT=https://REPLACE-ME.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE-ME

# Data & Tools — real values belong in .env.local (gitignored), not here.
AZURE_SEARCH_ENDPOINT=https://REPLACE-ME.search.windows.net/
AZURE_SEARCH_API_KEY=REPLACE-ME
AZURE_SPEECH_KEY=REPLACE-ME
AZURE_SPEECH_REGION=eastus

# Guardrails — only needed if a usecase enables azure_content_safety in
# config/guardrails.yaml. Real values belong in .env.local (gitignored), not here.
AZURE_CONTENT_SAFETY_ENDPOINT=https://REPLACE-ME.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_API_KEY=REPLACE-ME

# Observability — only needed if a usecase constructs AzureMonitorTracer.
# Real value belongs in .env.local (gitignored), not here.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# Feedback Loop — only needed if a usecase constructs AzureBlobFeedbackStore.
# Real value belongs in .env.local (gitignored), not here.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=REPLACE-ME;AccountKey=REPLACE-ME;EndpointSuffix=core.windows.net
