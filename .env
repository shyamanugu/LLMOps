# Foundation configuration — placeholder values only, no live secrets.
# See docs/decisions/0001-repo-foundation-approach.md for why this file is tracked in source
# instead of ignored, and why Key Vault is not used yet.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus
ENVIRONMENT=dev
RESOURCE_GROUP_NAME=rg-llmops-dev-eastus-001
MANAGED_IDENTITY_NAME=id-llmops-dev-eastus-001

# Model Management — real values belong in .env.local (gitignored), not here.
AZURE_OPENAI_ENDPOINT=https://REPLACE-ME.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE-ME
